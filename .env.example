# Never commit the real .env file.
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# Low-cost multi-model team.
CHAT_PROVIDER=gemini
CHAT_MODEL=gemini-3.8-flash
CHAT_REASONING_EFFORT=low

MANAGER_PROVIDER=gemini
MANAGER_MODEL=gemini-3.8-flash
MANAGER_REASONING_EFFORT=high

CODING_PROVIDER=gemini
CODING_MODEL=gemini-3.8-flash
CODING_REASONING_EFFORT=medium

GENERAL_PROVIDER=gemini
GENERAL_MODEL=gemini-3.8-flash
GENERAL_REASONING_EFFORT=low

REVIEW_PROVIDER=openai
REVIEW_MODEL=gpt-5.4-mini
REVIEW_REASONING_EFFORT=medium

ESCALATION_PROVIDER=openai
ESCALATION_MODEL=gpt-5.6-sol
ESCALATION_REASONING_EFFORT=high
AUTO_ESCALATION_ENABLED=true

# Coding tools can only resolve file paths under this directory.
# Backslashes may be written normally in a .env file.
AGENT_WORKSPACE_ROOT=C:\workspace
# Optional semicolon-separated registration boundaries for additional projects.
# Keep this as narrow as possible. Defaults to AGENT_WORKSPACE_ROOT only.
AGENT_WORKSPACE_ALLOWED_ROOTS=C:\workspace
AGENT_DB_PATH=data/agent.db

MAX_AGENT_STEPS=15
COMMAND_TIMEOUT_SECONDS=120
MAX_TOOL_OUTPUT_CHARS=20000
USAGE_LOG_PATH=logs/llm_usage.jsonl

# Optional Korea Real Estate Analyst official-source keys.
# The rest of the app and fixture-based tests work without these values.
MOLIT_API_KEY=
RONE_API_KEY=
REAL_ESTATE_SOURCE_TIMEOUT_SECONDS=20
REAL_ESTATE_SOURCE_MAX_BYTES=2000000
# Optional semicolon-separated official policy document URLs for daily collection.
REAL_ESTATE_POLICY_FEED_URLS=
